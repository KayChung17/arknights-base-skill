{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KayChung17/arknights-base-skill/blob/main/skills/ark-base-schedule/schemas/project-config.schema.json",
  "title": "明日方舟基建优化项目配置",
  "type": "object",
  "required": ["schema_version", "mode", "roster", "objective", "base_state", "horizon", "right_side_schedule"],
  "properties": {
    "schema_version": {"const": 1},
    "project_name": {"type": "string"},
    "mode": {"enum": ["layout_search", "upgrade_search", "fixed_schedule"]},
    "roster": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string"},
    "operator_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "elite": {"type": "integer", "minimum": 0, "maximum": 2},
          "level": {"type": "integer", "minimum": 1, "maximum": 90},
          "recruited": {"type": "boolean"},
          "morale": {"type": "number", "minimum": 0, "maximum": 24}
        },
        "additionalProperties": false
      }
    },
    "layout": {"type": "string", "pattern": "^[1-5][1-5][1-3]$"},
    "objective": {
      "type": "object",
      "required": ["goal", "online_schedule", "minimum_net_lmd_per_day", "max_daily_work_hours"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "online_times": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
        },
        "online_schedule": {
          "type": "object",
          "required": ["mode", "count"],
          "properties": {
            "mode": {"enum": ["fixed", "optimize"]},
            "count": {"type": "integer", "minimum": 1, "maximum": 4},
            "candidate_step_minutes": {"type": "integer", "minimum": 1},
            "max_candidates": {"type": "integer", "minimum": 1},
            "continuous_refinement": {"type": "boolean"},
            "refinement_max_candidates": {"type": "integer", "minimum": 0, "maximum": 500}
          },
          "additionalProperties": false
        },
        "minimum_net_lmd_per_day": {"type": "number"},
        "minimum_originium_shard_balance": {"type": "number", "default": 0},
        "minimum_orundum_shard_balance": {"type": "number", "deprecated": true},
        "minimum_pure_gold_balance": {"type": "number", "default": 0},
        "economic_values": {"$ref": "#/$defs/economicValues"},
        "max_daily_work_hours": {"type": "number", "minimum": 0, "maximum": 24},
        "max_orundum_trading_posts": {"type": "integer", "minimum": 1},
        "max_shard_factories": {"type": "integer", "minimum": 1},
        "minimum_battle_record_factories": {"type": "integer", "minimum": 0}
        ,"balance_policy": {
          "type": "object",
          "properties": {
            "originium_shard": {"$ref": "#/$defs/resourceBalancePolicy"},
            "pure_gold": {"$ref": "#/$defs/resourceBalancePolicy"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "base_state": {
      "type": "object",
      "required": ["drone_capacity", "initial_drone_stock", "dormitory_levels", "right_side_levels", "right_side_levels_confirmed"],
      "properties": {
        "drone_capacity": {"type": "number", "minimum": 0},
        "initial_drone_stock": {"type": "number", "minimum": 0},
        "inventory": {
          "type": "object",
          "properties": {
            "originium_shard": {"type": ["number", "null"], "minimum": 0},
            "pure_gold": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        },
        "dormitory_levels": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"type": "integer", "minimum": 1, "maximum": 5}
        },
        "right_side_levels": {
          "type": "object",
          "required": ["reception_room", "office", "training_room", "workshop"],
          "properties": {
            "reception_room": {"type": "integer", "minimum": 1, "maximum": 3},
            "office": {"type": "integer", "minimum": 1, "maximum": 3},
            "training_room": {"type": "integer", "minimum": 1, "maximum": 3},
            "workshop": {"type": "integer", "minimum": 1, "maximum": 3}
          }
        },
        "right_side_levels_confirmed": {"const": true}
      },
      "additionalProperties": true
    },
    "horizon": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["steady_state", "finite_days"]},
        "days": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["representative", "level_grid"]},
        "ids": {"type": "array", "items": {"type": "string"}},
        "file": {"type": "string"},
        "layouts": {"type": "array", "items": {"type": "string"}},
        "max_profiles": {"type": "integer", "minimum": 1}
      }
    },
    "search": {
      "type": "object",
      "properties": {
        "top_k": {"type": "integer", "minimum": 1},
        "operator_pool_size": {"type": "integer", "minimum": 1},
        "time_limit_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_proxy_attempts": {"type": "integer", "minimum": 1},
        "top_solutions": {"type": "integer", "minimum": 1},
        "mip_rel_gap": {"type": "number", "minimum": 0},
        "lmd_proxy_floor_slack": {"type": "number", "minimum": 0}
        ,"proxy_shard_consumption_factor": {"type": "number", "minimum": 1}
        ,"proxy_gold_consumption_factor": {"type": "number", "minimum": 1}
        ,"proxy_lmd_cost_factor": {"type": "number", "minimum": 1}
        ,"opportunity_postprocess_max_iterations": {"type": "integer", "minimum": 0, "maximum": 20}
        ,"allow_product_switching": {"type": "boolean"}
        ,"adaptive_candidate_expansion_rounds": {"type": "integer", "minimum": 0, "maximum": 8}
        ,"adaptive_candidate_expansion_factor": {"type": "number", "minimum": 1.1, "maximum": 4}
        ,"adaptive_candidate_max_top_k": {"type": "integer", "minimum": 1}
        ,"adaptive_candidate_max_operator_pool_size": {"type": "integer", "minimum": 1}
        ,"random_order_trials": {"type": "integer", "minimum": 0, "maximum": 10000}
        ,"random_order_seed": {"type": "integer"}
      }
    },
    "upgrades": {
      "type": "object",
      "properties": {"marginal_limit": {"type": "integer", "minimum": 0}}
    },
    "preferences": {"type": "object"},
    "right_side_schedule": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["meeting", "hire"],
        "properties": {
          "meeting": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
          "hire": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "strict_warnings": {"type": "boolean"},
        "stability_check": {"type": "boolean"},
        "expanded_factor": {"type": "number", "exclusiveMinimum": 0},
        "require_all_unlocked_skills_structured": {"type": "boolean"},
        "relevant_unmodeled_skill_policy": {"enum": ["warn", "block"]}
      },
      "additionalProperties": true
    },
    "facility_configuration": {"type": "object"}
  },
  "$defs": {
    "economicValues": {
      "type": "object",
      "properties": {
        "orundum_lmd": {"type": "number", "minimum": 0},
        "orundum_shard_shortfall_lmd": {"type": "number", "minimum": 0},
        "pure_gold_shortfall_lmd": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resourceBalancePolicy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["hard", "soft"]},
        "shortfall_penalty": {"type": "number", "minimum": 0},
        "hard_minimum": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "fixed_schedule"}}},
      "then": {"required": ["layout", "facility_configuration"]}
    }
  ],
  "additionalProperties": true
}
